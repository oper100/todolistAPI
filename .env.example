# Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# PostgreSQL (used by docker compose)
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=todolist

# Only for running the app without Docker (host is localhost).
# Use the same user, password and database name as above.
DATABASE_URL=postgresql+psycopg://todo_user:change-me@localhost:5432/todolist
